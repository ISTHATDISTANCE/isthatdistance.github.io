---
---
<article id="{{ entry.key }}" class="research-publication" data-topic="{{ entry.topic | escape }}" aria-labelledby="title-{{ entry.key }}">
  {% if site.enable_publication_thumbnails and entry.preview %}
    {% assign preview_path = entry.preview %}
    {% unless entry.preview contains '://' %}
      {% assign preview_path = entry.preview | prepend: '/assets/img/publication_preview/' | relative_url %}
    {% endunless %}
    {% assign original_preview_path = preview_path %}
    {% case entry.key %}
      {% when 'lu2025egoexoactivepassive' %}
        {% assign preview_path = '/assets/img/research/immersive-storytelling-cover.webp' | relative_url %}
        {% assign original_preview_path = '/assets/img/research/immersive-storytelling-figure.webp' | relative_url %}
      {% when 'zhu2024compositingvis' %}
        {% assign preview_path = '/assets/img/research/compositing-vis-cover.webp' | relative_url %}
        {% assign original_preview_path = '/assets/img/research/compositing-vis-figure.webp' | relative_url %}
      {% when 'lu2024interactout' %}
        {% assign preview_path = '/assets/img/research/interactout-cover.webp' | relative_url %}
        {% assign original_preview_path = '/assets/img/research/interactout-figure.webp' | relative_url %}
    {% endcase %}
    <a
      class="research-preview"
      href="{{ original_preview_path }}"
      aria-label="View full figure for {{ entry.short_title | default: entry.title | escape }}"
    >
      <img
        src="{{ preview_path }}"
        alt="{{ entry.short_title | default: entry.title | escape }} research preview"
        loading="lazy"
        decoding="async"
        width="640"
        height="400"
      >
    </a>
  {% endif %}

  <div class="research-publication-body">
    <div class="research-meta">
      <span class="research-venue">
        {{- entry.abbr }}
        {{ entry.year -}}
      </span>
      {% if entry.topic_label -%}
        <span class="research-topic">{{ entry.topic_label }}</span>
      {%- endif %}
    </div>
    <h3 class="research-title" id="title-{{ entry.key }}">{{ entry.short_title | default: entry.title }}</h3>
    {% if entry.short_title %}
      <p class="research-full-title">{{ entry.title }}</p>
    {% endif %}

    <div class="research-authors">
      {%- for author in entry.author_array -%}
        {%- assign author_is_self = false -%}
        {%- assign author_last_name = author.last | remove: '¶' | remove: '&' | remove: '*' | remove: '†' | remove: '^' -%}
        {%- if site.scholar.last_name contains author_last_name and site.scholar.first_name contains author.first -%}
          {%- assign author_is_self = true -%}
        {%- endif -%}
        {%- assign coauthor_url = null -%}
        {%- assign clean_last_name = author_last_name | downcase | remove_accents -%}
        {%- if site.data.coauthors[clean_last_name] -%}
          {%- for coauthor in site.data.coauthors[clean_last_name] -%}
            {%- if coauthor.firstname contains author.first -%}
              {%- assign coauthor_url = coauthor.url -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- unless forloop.first -%}
          {{ ', ' -}}
          {%- if forloop.last %}{{ 'and ' }}{% endif %}
        {%- endunless -%}
        {%- if author_is_self -%}
          <strong>
            {{- author.first }}
            {{ author.last -}}
          </strong>
        {%- elsif coauthor_url -%}
          <a href="{{ coauthor_url }}">
            {{- author.first }}
            {{ author.last -}}
          </a>
        {%- else -%}
          {{ author.first }}
          {{ author.last }}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {% if entry.summary %}
      <p class="research-summary">{{ entry.summary }}</p>
    {% endif %}
    {% if entry.note %}
      <p class="research-note">{{ entry.note }}</p>
    {% endif %}
    {% if entry.additional_info %}
      <div class="research-note">{{ entry.additional_info | markdownify }}</div>
    {% endif %}

    <div class="research-actions" aria-label="Publication resources">
      {% if entry.pdf %}
        {% assign pdf_path = entry.pdf %}
        {% unless entry.pdf contains '://' %}{% assign pdf_path = entry.pdf | prepend: '/assets/pdf/' | relative_url %}{% endunless %}
        <a href="{{ pdf_path }}">PDF <span aria-hidden="true">↗</span></a>
      {% endif %}
      {% if entry.video -%}
        <a href="{{ entry.video }}">Video <span aria-hidden="true">↗</span></a>
      {%- endif %}
      {% if entry.arxiv -%}
        <a href="https://arxiv.org/abs/{{ entry.arxiv }}">arXiv <span aria-hidden="true">↗</span></a>
      {%- endif %}
      {% if entry.html %}
        {% assign html_path = entry.html %}
        {% unless entry.html contains '://' %}{% assign html_path = entry.html | prepend: '/assets/html/' | relative_url %}{% endunless %}
        <a href="{{ html_path }}">HTML <span aria-hidden="true">↗</span></a>
      {% endif %}
      {% if entry.supp %}
        {% assign supplement_path = entry.supp %}
        {% unless entry.supp contains '://' %}{% assign supplement_path = entry.supp | prepend: '/assets/pdf/' | relative_url %}{% endunless %}
        <a href="{{ supplement_path }}">Supplement <span aria-hidden="true">↗</span></a>
      {% endif %}
      {% if entry.blog -%}
        <a href="{{ entry.blog }}">Blog <span aria-hidden="true">↗</span></a>
      {%- endif %}
      {% if entry.code -%}
        <a href="{{ entry.code }}">Code <span aria-hidden="true">↗</span></a>
      {%- endif %}
      {% if entry.poster %}
        {% assign poster_path = entry.poster %}
        {% unless entry.poster contains '://' %}{% assign poster_path = entry.poster | prepend: '/assets/pdf/' | relative_url %}{% endunless %}
        <a href="{{ poster_path }}">Poster <span aria-hidden="true">↗</span></a>
      {% endif %}
      {% if entry.slides %}
        {% assign slides_path = entry.slides %}
        {% unless entry.slides contains '://' %}{% assign slides_path = entry.slides | prepend: '/assets/pdf/' | relative_url %}{% endunless %}
        <a href="{{ slides_path }}">Slides <span aria-hidden="true">↗</span></a>
      {% endif %}
      {% if entry.website -%}
        <a href="{{ entry.website }}">Project <span aria-hidden="true">↗</span></a>
      {%- endif %}
    </div>

    <div class="research-details-list">
      {% if entry.abstract %}
        <details class="research-details">
          <summary>Abstract</summary>
          <div class="research-details-content">
            <p>{{ entry.abstract }}</p>
          </div>
        </details>
      {% endif %}
      {% if entry.bibtex_show %}
        <details class="research-details research-citation">
          <summary>BibTeX</summary>
          <div class="research-details-content">
            <div class="research-copy-controls" hidden>
              <button
                type="button"
                class="research-copy"
                aria-label="Copy BibTeX citation for {{ entry.short_title | default: entry.title | escape }}"
              >
                Copy citation
              </button>
              <span class="research-copy-status" role="status" aria-live="polite"></span>
            </div>
            <pre><code>{{ entry.bibtex | hideCustomBibtex | escape }}</code></pre>
          </div>
        </details>
      {% endif %}
      {% if entry.award %}
        <details class="research-details">
          <summary>{{ entry.award_name | default: 'Award' }}</summary>
          <div class="research-details-content">{{ entry.award | markdownify }}</div>
        </details>
      {% endif %}
    </div>
  </div>
</article>
