---
layout: default
---
<div class="home-page">
  <section class="home-hero" aria-labelledby="profile-name">
    <div class="home-introduction">
      <p class="eyebrow">Human–Computer Interaction</p>
      <header class="profile-heading">
        <img class="profile-portrait" src="{{ '/assets/img/profile.jpg' | relative_url }}" alt="Tao Lu" width="84" height="100" fetchpriority="high">
        <div>
          <h1 id="profile-name">Tao Lu <span lang="zh">陆韬</span></h1>
          <p class="profile-affiliation">
            PhD student in Computer Science<br>
            Georgia Institute of Technology
          </p>
        </div>
      </header>
      <div class="home-bio">{{ content }}</div>
      <div class="profile-links" aria-label="Contact and academic profiles">
        <a class="profile-button primary" href="{{ '/assets/pdf/en-us/Tao_CV.pdf' | relative_url }}"
          >Curriculum vitae <span aria-hidden="true">↗</span></a
        >
        <a class="profile-button" href="mailto:{{ site.email }}">Email me <span aria-hidden="true">↗</span></a>
        <a class="profile-text-link" href="https://scholar.google.com/citations?user={{ site.scholar_userid }}"
          >Scholar <span aria-hidden="true">↗</span></a
        >
        <a class="profile-text-link" href="https://www.linkedin.com/in/{{ site.linkedin_username }}/">LinkedIn <span aria-hidden="true">↗</span></a>
      </div>
      <div class="education-block">
        <h2 class="eyebrow">Education</h2>
        <ul class="education-list">
          <li>
            <span class="institution-mark" aria-hidden="true"
              ><img src="{{ '/assets/img/institutions/georgia-tech.png' | relative_url }}" alt="" width="32" height="32"
            ></span>
            <div>
              <strong>Georgia Tech</strong><span>PhD, Computer Science · 2025–present</span><span>MS, Human–Computer Interaction · 2025</span>
            </div>
          </li>
          <li>
            <span class="institution-mark" aria-hidden="true"
              ><img src="{{ '/assets/img/institutions/michigan.png' | relative_url }}" alt="" width="32" height="32"
            ></span>
            <div><strong>University of Michigan</strong><span>BS, Computer Science · 2023</span></div>
          </li>
          <li>
            <span class="institution-mark" aria-hidden="true"
              ><img src="{{ '/assets/img/institutions/sjtu.png' | relative_url }}" alt="" width="32" height="32"
            ></span>
            <div><strong>Shanghai Jiao Tong University</strong><span>Bachelor's, Computer Science · 2023</span></div>
          </li>
        </ul>
      </div>
    </div>
    <aside class="featured-work" aria-labelledby="featured-title">
      <div class="section-kicker">
        <h2 id="featured-title">Selected work</h2>
        <a href="#research">Explore research <span aria-hidden="true">↘</span></a>
      </div>
      <div class="featured-grid">
        {% bibliography --template research-card --query @*[selected=true] --group_by none %}
      </div>
      <p class="featured-note">Exploring how we interact with stories, data, and everyday technology.</p>
    </aside>
  </section>
  <section class="home-news" aria-labelledby="news-title">
    <div class="section-heading">
      <h2 id="news-title">News &amp; updates</h2>
      <span class="section-subtitle">Along the way</span>
    </div>
    <ol class="news-timeline">
      {% assign latest_news = site.news | sort: 'date' | reverse %}
      {% for item in latest_news limit: 3 %}
        <li>
          <time datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%b %Y' }}</time>
          <div>{{ item.content }}</div>
        </li>
      {% endfor %}
    </ol>
  </section>
  <section id="research" class="home-research" aria-labelledby="research-title">
    <div class="section-heading">
      <h2 id="research-title">Research</h2>
      <a class="section-link" href="{{ '/publications/' | relative_url }}">All publications <span aria-hidden="true">↗</span></a>
    </div>
    <p class="section-intro">Immersive storytelling, embodied interaction, and technology that supports everyday life.</p>
    {% include research-publications.liquid %}
  </section>
  <section class="contact-strip" aria-labelledby="contact-title">
    <div>
      <p class="eyebrow">Let's connect</p>
      <h2 id="contact-title">Have a story to share?</h2>
      <p>I'm always happy to talk about HCI, immersive experiences, and research.</p>
    </div>
    <a class="profile-button" href="mailto:{{ site.email }}">
      {{- site.email }}
      <span aria-hidden="true">↗</span></a
    >
  </section>
</div>
