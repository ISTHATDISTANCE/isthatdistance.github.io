@article{lu2024interactout,
  title={InteractOut: Leveraging Interaction Proxies as Input Manipulation Strategies for Reducing Smartphone Overuse},
  author={Tao Lu and Zheng, Hongxiao and Zhang, Tianying and Xu, Xuhai and Guo, Anhong},
  abstract={Smartphone overuse has become a prevalent issue, leading to negative impacts on users' well-being and productivity. To address this challenge, we introduce InteractOut, a novel approach that leverages interaction proxies as input manipulation strategies to help users reduce smartphone overuse. InteractOut employs a combination of physical and virtual interaction proxies to create a more engaging and mindful user experience. We conducted a series of user studies to evaluate the effectiveness of InteractOut in reducing smartphone usage time and enhancing user awareness of their smartphone habits. The results demonstrate that InteractOut significantly reduces smartphone overuse while maintaining user satisfaction and engagement. Our findings suggest that interaction proxies can be an effective tool for promoting healthier smartphone usage patterns.},
  journal={Proceedings of the CHI Conference on Human Factors in Computing Systems},
  year={2024},
  abbr={CHI},
  selected={true},
  preview={OverlayStructure_light.svg},
  bibtex_show={true},
  video={https://youtu.be/pyFerOeuWnQ},
  pdf={InteractOut.pdf}
}

