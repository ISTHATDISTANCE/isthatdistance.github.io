<header class="site-header">
  <nav class="site-nav container" aria-label="Main navigation">
    <a class="site-wordmark" href="{{ '/' | relative_url }}" aria-label="Tao Lu home">Tao Lu<span class="wordmark-dot" aria-hidden="true">.</span></a>
    <div class="site-nav-links">
      <a
        href="{{ '/' | relative_url }}"
        {% if page.permalink == '/' %}
          aria-current="page"
        {% endif %}
        >About</a
      >
      <a
        href="{{ '/publications/' | relative_url }}"
        {% if page.permalink == '/publications/' %}
          aria-current="page"
        {% endif %}
        >Research</a
      >
      <a
        href="{{ '/cv/' | relative_url }}"
        {% if page.permalink == '/cv/' %}
          aria-current="page"
        {% endif %}
        >CV</a
      >
      {% if site.enable_darkmode %}
        <button id="light-toggle" class="theme-toggle" type="button" title="Change color theme" aria-label="Change color theme">
          <i class="ti ti-sun-moon" id="light-toggle-system" aria-hidden="true"></i>
          <i class="ti ti-moon-filled" id="light-toggle-dark" aria-hidden="true"></i>
          <i class="ti ti-sun-filled" id="light-toggle-light" aria-hidden="true"></i>
        </button>
      {% endif %}
    </div>
  </nav>
</header>
